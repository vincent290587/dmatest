{
    "version": 8,
    "configurePresets": [
        {
            "name": "GCC 13.3.0 arm-amd-linux-gnueabi",
            "displayName": "GCC 13.3.0 arm-amd-linux-gnueabi",
            "description": "Using compilers: C = /usr/bin/arm-amd-linux-gnueabi-gcc, CXX = /usr/bin/arm-amd-linux-gnueabi-g++",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/bin/arm-amd-linux-gnueabi-gcc",
                "CMAKE_CXX_COMPILER": "/usr/bin/arm-amd-linux-gnueabi-g++",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ]
}